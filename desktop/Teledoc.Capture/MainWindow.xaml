<Window x:Class="Teledoc.Capture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teledoc Capture — Estação de Digitalização Ricoh/Fujitsu fi-8170"
        Height="760" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho da Estação -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="10" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TELEDOC CAPTURE — ESTAÇÃO OPERACIONAL" Foreground="#F8FAFC" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Hardware: Ricoh / Fujitsu fi-8170 (PaperStream IP TWAIN) • Perfil Ativo: 004 : BPO (300 DPI / Rotação Auto / Descarte Branco)"
                               Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#064E3B" CornerRadius="6" Padding="12,6" Margin="0,0,12,0">
                        <TextBlock x:Name="TxtApiStatus" Text="API ONLINE (localhost:8000)" Foreground="#34D399" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                    <Button x:Name="BtnStartScan"
                            Content="▶ INICIAR DIGITALIZAÇÃO DE LOTE (fi-8170)"
                            Click="BtnStartScan_Click"
                            Background="#2563EB" Foreground="White"
                            FontWeight="Bold" FontSize="14"
                            Padding="22,12" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barra de Métricas em Tempo Real -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="LOTE ATUAL" Foreground="#94A3B8" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtBatchId" Text="Aguardando início..." Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="PÁGINAS DIGITALIZADAS" Foreground="#94A3B8" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtPageCount" Text="0 folhas" Foreground="#38BDF8" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="FILA DE UPLOAD API" Foreground="#94A3B8" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtQueueStatus" Text="0 pendentes" Foreground="#34D399" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="ÚLTIMO BARCODE CODE 128" Foreground="#94A3B8" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtLastBarcode" Text="---" Foreground="#FBBF24" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Painel de Miniaturas / Fluxo de Páginas em Tempo Real -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="10" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="MONITOR DE INGESTÃO EM MEMÓRIA E SEPARAÇÃO AUTOMÁTICA (CODE 128)"
                           Foreground="#CBD5E1" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>
                <ListBox x:Name="LstScannedPages" Grid.Row="1"
                         Background="#0F172A" Foreground="#F8FAFC"
                         BorderThickness="0" FontFamily="Consolas" FontSize="13"/>
            </Grid>
        </Border>

        <!-- Rodapé de Status -->
        <Border Grid.Row="3" Background="#1E293B" CornerRadius="8" Padding="14,10" Margin="0,14,0,0">
            <TextBlock x:Name="TxtFooterStatus"
                       Text="Pronto para captura contínua. Insira os lotes físicos no alimentador ADF do scanner fi-8170."
                       Foreground="#94A3B8" FontSize="12"/>
        </Border>
    </Grid>
</Window>
